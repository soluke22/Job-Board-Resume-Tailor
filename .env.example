# Server-only. No values belong in source or VITE_* variables.
# Public demo/health/build require none of the private configuration below.
# Required together for private authentication/workspace; use one exact origin.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
# Hosted structured-model path. Vercel supplies Gateway authentication through OIDC;
# outside Vercel, AI_GATEWAY_API_KEY is the optional server-only credential.
AI_PROVIDER=gateway
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5
AI_GATEWAY_API_KEY=
# DEAD_COMPATIBILITY_CODE_PENDING_REMOVAL: not used by deployed structured workflows.
GEMINI_API_KEY=
# Developer-only explicit local structured-model opt-in.
# Ollama's local API has no authentication; keep its default loopback binding and
# never expose it on 0.0.0.0 or use this setting in deployed environments.
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:14b
# Vercel: connect a PRIVATE store to the intended project/environment using OIDC.
# Store ID is configuration, not a secret. VERCEL_OIDC_TOKEN is provider-managed;
# do not copy it, commit it, or explicitly pass it (SDK refreshes implicitly).
BLOB_STORE_ID=
# Local/outside Vercel only: static fallback for the isolated nonproduction store.
# Not required on Vercel when OIDC + BLOB_STORE_ID is available.
BLOB_READ_WRITE_TOKEN=
