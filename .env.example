# Server-only. No values belong in source or VITE_* variables.
# Public demo/health/build require none of the private configuration below.
# Required together for private authentication/workspace; use one exact origin.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
# Required only for private AI operations.
GEMINI_API_KEY=
# Vercel: connect a PRIVATE store to the intended project/environment using OIDC.
# Store ID is configuration, not a secret. VERCEL_OIDC_TOKEN is provider-managed;
# do not copy it, commit it, or explicitly pass it (SDK refreshes implicitly).
BLOB_STORE_ID=
# Local/outside Vercel only: static fallback for the isolated nonproduction store.
# Not required on Vercel when OIDC + BLOB_STORE_ID is available.
BLOB_READ_WRITE_TOKEN=
